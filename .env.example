# Zyte 유료 호출은 중지되어 있으며 키를 설정해도 활성화되지 않습니다.
# ZYTE_API_KEY=legacy_key_unused
# 카카오맵 무료 쿼터 대상 앱에서 Maps API를 활성화한 뒤 설정합니다.
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here
# GOOGLE_MAPS_API_KEY는 위치 검색에서 사용하지 않습니다.
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here
OPINET_API_KEY=your_opinet_api_key_here
HEALTH_CHECK_SECRET=your_health_check_secret_here
HEALTH_CHECK_BASE_URL=http://localhost:8787
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CF_WORKER_SCRIPT_NAME=daiso-mcp

# 올리브영 무료 전용 브라우저 릴레이 (선택, 사용자 입력으로 전달하지 않음)
OY_RELAY_URL=
OY_RELAY_TOKEN=
# 로컬 릴레이 실행용 선택 설정
OY_RELAY_PORT=4319
OY_BROWSER_EXECUTABLE=

# 선택: Cloudflare Access로 보호한 올리브영 중계의 서비스 인증
OY_ACCESS_CLIENT_ID=
OY_ACCESS_CLIENT_SECRET=
# 로컬 중계 전용 상태 디렉터리. 호출 원장과 브라우저 소유 마커를 보관합니다.
# OY_RELAY_STATE_DIR=/Users/daisorelay/Library/Application Support/DaisoRelay/state
